{
  "_comentario_general": "Configuración de experimentos y análisis para el motor de Algoritmos Genéticos (Fase 12)",
  "output_dir": "results/analysis",
  "base_config_path": "config/conf.json",
  "use_random_seed": false,
  "default_seed": 33333333,
  "experiments": [
    {
      "id": "ejemplo_operador_aislado",
      "name": "Comparación de Selección Aislada",
      "description": "Evalúa la presión de selección de cada método sobre una población sintética fija sin correr el ciclo evolutivo entero",
      "enabled": false,
      "type": "operator",
      "operator_target": "seleccion",
      "iterations": 1000,
      "population_size": 100,
      "selected_count": 20,
      "variants": [
        {
          "id": "elite",
          "name": "Elite",
          "overrides": { "seleccion": "elite" }
        },
        {
          "id": "torneo_det_3",
          "name": "Torneo Determinístico (k=3)",
          "overrides": { "seleccion": "torneo_deterministico", "tournament_size": 3 }
        }
      ],
      "outputs": {
        "plots": ["frecuencia_seleccion"],
        "save_csv": true,
        "save_summary": true
      }
    },
    {
      "id": "ejemplo_motor_completo",
      "name": "Evolución Completa",
      "description": "Ejecuta main.py de punta a punta acumulando métricas generacionales de fitness y diversidad",
      "enabled": false,
      "type": "full",
      "base_overrides": {
        "gene_count": 100,
        "population_size": 30,
        "selected_count": 14,
        "max_generations": 40,
        "output_resolution_mult": 0.3,
        "save_every_n_generations": 0,
        "save_best": false
      },
      "variants": [
        {
          "id": "dos_puntos",
          "name": "Dos Puntos",
          "overrides": { "cruza": "dos_puntos" }
        },
        {
          "id": "uniforme",
          "name": "Uniforme",
          "overrides": { "cruza": "uniforme", "uniform_crossover_P": 0.5 }
        }
      ],
      "outputs": {
        "plots": [
          "fitness_maximo",
          "fitness_promedio",
          "diversidad",
          "tiempo_generacion"
        ],
        "save_csv": true,
        "save_summary": true,
        "save_images": false,
        "save_gif": false
      }
    }
  ]
}
